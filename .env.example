# Copy to .env and fill in your real keys.
# DO NOT commit the .env file — it's gitignored.

# Composio API key (for getToolkits registry lookup)
# Get one at https://composio.dev → Sign up → Settings → API Keys
COMPOSIO_KEY=your_composio_api_key_here

# Z.ai GLM API key (for extraction LLM)
# Get one at https://open.bigmodel.cn → API Keys
GLM_KEY=your_glm_api_key_here
